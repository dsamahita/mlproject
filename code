import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_squared_error

# Data
data = {
    "Year": list(range(2014, 2025)) * 3,

    "Crop": (
        ["Almonds"] * 11 +
        ["Avocados"] * 11 +
        ["Cherries"] * 11
    ),

    "Yield": (
        [3066, 3192.7, 3279.7, 6676.3, 3391.8,
         3446.9, 3954.9, 4292.3, 4293.4, 4383.5, 4601.6]

        +

        [6628.6, 6383.9, 6529.5, 7722.9, 8477.6,
         10412.3, 8997.7, 9243, 9567.6, 9203.6, 8866.5]

        +

        [4177.4, 4187.1, 4175, 4174, 4178.8,
         4175.9, 4183.2, 4179.3, 4179.5, 4180.7, 4179.9]
    )
}

df = pd.DataFrame(data)

# -------------------------------
# Linear regression for each crop
# -------------------------------

for crop in df["Crop"].unique():

    crop_data = df[df["Crop"] == crop]

    X = crop_data[["Year"]]
    y = crop_data["Yield"]

    model = LinearRegression()
    model.fit(X, y)

    prediction_2030 = model.predict([[2030]])[0]

    print("\n", crop)
    print("Slope =", model.coef_[0])
    print("Intercept =", model.intercept_)
    print("2030 prediction =", prediction_2030)

    # R2
    y_pred = model.predict(X)

    print("R² =", r2_score(y, y_pred))
    print("RMSE =", np.sqrt(mean_squared_error(y, y_pred))) 
